{
  "name": "@inoxpran/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "npm run build -w @inoxpran/contracts",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude dist/**",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "smoke:api": "tsx src/scripts/smoke-api.ts",
    "smoke:worker": "tsx src/scripts/smoke-worker.ts",
    "seed:demo:reset": "tsx src/scripts/seed-demo.ts --reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@inoxpran/contracts": "*",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@nestjs/swagger": "12.0.2",
    "bullmq": "^6.3.10",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "fastify": "5.12.5",
    "ioredis": "^6.0.0",
    "js-yaml": "5.4.2",
    "mongodb": "^6.20.0",
    "otplib": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
