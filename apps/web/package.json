{
  "name": "@inoxpran/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @inoxpran/contracts",
    "dev": "vite",
    "prebuild": "svelte-kit sync",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests --exclude build/** --exclude .svelte-kit/**"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/be-vietnam-pro": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@inoxpran/contracts": "*",
    "cookie": "2.0.1",
    "lucide-svelte": "^0.545.0",
    "pdfmake": "0.3.13",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.10.0",
    "@types/pdfmake": "0.3.3",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.3"
  }
}
