NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/inoxpran_erp?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=inoxpran_erp
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-a-second-32-character-secret
COOKIE_SECURE=false
MFA_ENFORCE_PRIVILEGED=false
ADMIN_EMAIL=admin@inoxpran.vn
ADMIN_PASSWORD=ChangeMe-Immediately-2026
ADMIN_NAME=Quản trị INOXPRAN
ADMIN_TOTP_SECRET=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=inoxpran-erp-local
# Máy dev dùng S3 giả lập (docker compose up -d s3). Môi trường thật: bỏ trống 4 biến dưới — dùng IAM role của ECS task.
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=local-dev
S3_SECRET_ACCESS_KEY=local-dev
# Chỉ bật ở máy dev: API tự tạo bucket nếu chưa có.
S3_AUTO_CREATE_BUCKET=true
# Quét mã độc file tải lên bằng ClamAV (docker compose up -d clamav). Production bắt buộc "clamav".
MALWARE_SCAN_MODE=clamav
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
AWS_SES_FROM_EMAIL=no-reply@inoxpran.vn
MISA_BASE_URL=https://actapp.misa.vn
MISA_APP_ID=
MISA_ACCESS_CODE=
MISA_ORG_COMPANY_CODE=

# Mật khẩu chung cho các tài khoản demo do seed:demo tạo (bỏ trống để sinh ngẫu nhiên)
DEMO_USER_PASSWORD=
# Lịch rà soát công nợ quá hạn (cron, giờ Asia/Ho_Chi_Minh)
OVERDUE_REVIEW_CRON=0 6 * * *
